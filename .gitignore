*.tfvars.json

# Ignorar ficheiros de crash ou log do Terraform
crash.log
terraform.log

# Ignorar ficheiros de plano guardados localmente
*.tfplan

# Ignorar ficheiro de lock de concorrência do HCL
.terraform.lock.hcl