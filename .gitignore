# Configurações e Estado do Terraform (Adicionado para a pasta /infra)
# -------------------------------------------------------------------

# Ignorar pastas temporárias e plugins descarregados pelo Terraform
.terraform/

# Ignorar o estado local do Terraform (contém dados sensíveis da Azure)
*.tfstate
*.tfstate.*

# Ignorar variáveis secretas locais do Terraform
